{
  "name": "openclaw-whatsapp-kapso",
  "version": "2026.4.30",
  "description": "Native OpenClaw channel plugin for WhatsApp via Kapso (WhatsApp Business Cloud API)",
  "author": {
    "name": "Tomas Ward",
    "url": "https://github.com/TomasWard1"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./setup-entry": {
      "types": "./dist/setup-entry.d.ts",
      "default": "./dist/setup-entry.js"
    },
    "./openclaw.plugin.json": "./openclaw.plugin.json"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "openclaw-channel",
    "whatsapp",
    "kapso",
    "whatsapp-cloud-api",
    "bot"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TomasWard1/openclaw-whatsapp-kapso.git"
  },
  "bugs": {
    "url": "https://github.com/TomasWard1/openclaw-whatsapp-kapso/issues"
  },
  "homepage": "https://github.com/TomasWard1/openclaw-whatsapp-kapso#readme",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.js.map",
    "dist/**/*.d.ts.map",
    "openclaw.plugin.json"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "node --import tsx --test $(find test -name '*.test.ts')",
    "test:watch": "node --import tsx --test --watch $(find test -name '*.test.ts')",
    "check:pack": "npm run build && npm pack --dry-run"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "setupEntry": "./dist/setup-entry.js",
    "channel": {
      "id": "whatsapp-kapso",
      "label": "WhatsApp (Kapso)",
      "selectionLabel": "WhatsApp via Kapso",
      "docsPath": "/channels/whatsapp-kapso",
      "docsLabel": "whatsapp-kapso",
      "blurb": "WhatsApp Business Cloud API via Kapso — a managed wrapper with webhooks, media, and sandbox support.",
      "order": 70,
      "quickstartAllowFrom": true
    },
    "install": {
      "npmSpec": "openclaw-whatsapp-kapso",
      "localPath": "extensions/whatsapp-kapso",
      "defaultChoice": "npm"
    }
  }
}
